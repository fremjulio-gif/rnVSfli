---
import type { JudicialCase } from '../lib/schema';
import { CATEGORIE_VALUES } from '../lib/schema';
import { formatDateFr, getDict } from '../i18n';

interface Props {
  cases: JudicialCase[];
}

const { cases } = Astro.props;
const dict = getDict('fr');

const minYear = 2010;
const maxYear = 2026;
const leftPad = 68;
const rightPad = 955;

function yearToX(isoDate: string): number {
  const y = Number(isoDate.slice(0, 4));
  const m = Number(isoDate.slice(5, 7)) || 6;
  const dec = Math.max(minYear, Math.min(maxYear + 0.95, y + (m - 1) / 12));
  const ratio = (dec - minYear) / (maxYear + 1 - minYear);
  return Math.round(leftPad + ratio * (rightPad - leftPad));
}

// Évite la superposition verticale quand plusieurs dossiers tombent la même année
const seenBuckets: Record<string, number> = {};
const plotted = cases
  .slice()
  .sort((a, b) => a.date_derniere_decision.localeCompare(b.date_derniere_decision))
  .map((c) => {
    const year = c.date_derniere_decision.slice(0, 4);
    const key = `${c.camp}-${year}`;
    const idx = seenBuckets[key] ?? 0;
    seenBuckets[key] = idx + 1;
    const baseY = c.camp === 'LFI' ? 88 : 206;
    const offset = c.camp === 'LFI' ? -(idx * 22) : idx * 22;
    return {
      item: c,
      x: yearToX(c.date_derniere_decision),
      y: Math.max(28, Math.min(272, baseY + offset)),
    };
  });

const ticks = [2010, 2012, 2014, 2016, 2018, 2020, 2022, 2024, 2026];
const milestones = [
  { year: '2011-01-16', label: '2011 · M. Le Pen prés. FN' },
  { year: '2016-02-10', label: '2016 · Création LFI' },
  { year: '2018-06-01', label: '2018 · FN → RN' },
];
---

<section id="frise" class="pixel-frame dataviz-card" aria-labelledby="timeline-chart-heading">
  <div class="dataviz-card__head">
    <span class="section-kicker">FRISE INTERACTIVE · 2010 → 2026</span>
    <h3 id="timeline-chart-heading" class="dataviz-card__title">
      CHRONOLOGIE VISUELLE DES DÉCISIONS &amp; PROCÉDURES
    </h3>
    <p class="section-desc" style="margin-top: 0.35rem;">
      Chaque marqueur représente un dossier à la date de sa dernière décision ou étape majeure connue
      au 26/11/2026. Survolez ou cliquez sur un marqueur pour ouvrir le dossier complet.
    </p>
  </div>

  <!-- Filtres compacts -->
  <div class="timeline-filter-bar" role="group" aria-label="Filtrer la frise chronologique">
    <label class="filter-chip-label">
      <span>Camp</span>
      <select id="chart-filter-camp" class="filter-input">
        <option value="ALL">Tous (LFI &amp; RN)</option>
        <option value="LFI">LFI / FdG</option>
        <option value="RN">RN (ex-FN)</option>
      </select>
    </label>

    <label class="filter-chip-label">
      <span>Statut</span>
      <select id="chart-filter-statut" class="filter-input">
        <option value="ALL">Tous les statuts</option>
        {
          Object.entries(dict.statuts).map(([k, v]) => (
            <option value={k}>{v.label}</option>
          ))
        }
      </select>
    </label>

    <label class="filter-chip-label">
      <span>Catégorie</span>
      <select id="chart-filter-cat" class="filter-input">
        <option value="ALL">Toutes les catégories</option>
        {
          CATEGORIE_VALUES.map((cat) => (
            <option value={cat}>{dict.categories[cat].label}</option>
          ))
        }
      </select>
    </label>

    <div class="timeline-count-pill" id="chart-visible-count">
      {cases.length} / {cases.length} dossier(s)
    </div>
  </div>

  <!-- Graphique SVG horizontal -->
  <div class="timeline-svg-scroll">
    <svg
      viewBox="0 0 1000 300"
      class="timeline-svg"
      role="img"
      aria-label="Frise chronologique interactive de 2010 à 2026 comparant les procédures LFI en haut et RN en bas"
    >
      <!-- Pistes LFI (haut) & RN (bas) -->
      <rect x="60" y="18" width="915" height="114" fill="rgba(245, 183, 59, 0.05)" stroke="rgba(245, 183, 59, 0.25)" />
      <rect x="60" y="168" width="915" height="114" fill="rgba(76, 201, 240, 0.05)" stroke="rgba(76, 201, 240, 0.25)" />

      <text x="14" y="80" fill="#F5B73B" font-size="11" font-weight="700" font-family="Press Start 2P, monospace">LFI</text>
      <text x="14" y="230" fill="#4CC9F0" font-size="11" font-weight="700" font-family="Press Start 2P, monospace">RN</text>

      <!-- Axe central 2010-2026 -->
      <line x1="60" y1="150" x2="975" y2="150" stroke="#A3B1CC" stroke-width="2" />

      {
        ticks.map((yr) => {
          const tx = yearToX(`${yr}-01-01`);
          return (
            <g>
              <line x1={tx} y1="142" x2={tx} y2="158" stroke="#A3B1CC" stroke-width="1.5" />
              <text
                x={tx}
                y="153"
                text-anchor="middle"
                fill="#F2F5FA"
                font-size="10"
                font-family="IBM Plex Mono, monospace"
                style="paint-order: stroke; stroke: #0B0E17; stroke-width: 5px;"
              >
                {yr}
              </text>
            </g>
          );
        })
      }

      {
        milestones.map((m) => {
          const mx = yearToX(m.year);
          return (
            <g>
              <line x1={mx} y1="18" x2={mx} y2="282" stroke="rgba(242, 245, 250, 0.22)" stroke-dasharray="4 4" />
              <text x={mx + 4} y="294" fill="#A3B1CC" font-size="8.5" font-family="IBM Plex Mono, monospace">
                {m.label}
              </text>
            </g>
          );
        })
      }

      <!-- Points cliquables -->
      {
        plotted.map(({ item, x, y }) => {
          const color = item.camp === 'LFI' ? '#F5B73B' : '#4CC9F0';
          const isDef = item.statut === 'condamnation_definitive';
          const isCleared = item.statut === 'relaxe' || item.statut === 'non_lieu' || item.statut === 'prescription';
          const isOngoing = item.section === 'procedures_en_cours';

          return (
            <g
              class="timeline-node"
              tabindex="0"
              role="button"
              data-open-case={item.id}
              data-camp={item.camp}
              data-statut={item.statut}
              data-categorie={item.categorie}
              data-tip={`${formatDateFr(item.date_derniere_decision)} · ${item.camp} · ${dict.statuts[item.statut].label} — ${item.titre}`}
              aria-label={`${item.camp} — ${item.titre} (${formatDateFr(item.date_derniere_decision)}, ${dict.statuts[item.statut].label})`}
            >
              {isDef ? (
                <rect x={x - 7} y={y - 7} width="14" height="14" fill={color} stroke="#0B0E17" stroke-width="2" />
              ) : isCleared ? (
                <circle cx={x} cy={y} r="7" fill="#0B0E17" stroke={color} stroke-width="2.5" />
              ) : isOngoing ? (
                <circle cx={x} cy={y} r="7" fill="rgba(11, 14, 23, 0.8)" stroke={color} stroke-width="2" stroke-dasharray="3 2" />
              ) : (
                <polygon points={`${x},${y - 8} ${x + 8},${y} ${x},${y + 8} ${x - 8},${y}`} fill={color} stroke="#0B0E17" stroke-width="2" />
              )}
            </g>
          );
        })
      }
    </svg>
  </div>

  <div class="timeline-hover-banner" id="timeline-hover-banner" aria-live="polite">
    Survolez ou sélectionnez un marqueur sur la frise (■ Définitif · ◆ Sous recours · ○ Relaxe/Classé · ◌ En cours).
  </div>
</section>
