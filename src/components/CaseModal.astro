---

<dialog id="dossier-modal" class="dossier-modal" aria-labelledby="modal-title">
  <div class="dossier-modal__inner pixel-frame">
    <header class="dossier-modal__header">
      <div>
        <span class="section-kicker" id="modal-kicker">DOSSIER JUDICIAIRE</span>
        <h2 id="modal-title" class="dossier-modal__title">Détail du dossier</h2>
      </div>
      <button
        type="button"
        id="modal-close-btn"
        class="arcade-btn arcade-btn--sm"
        aria-label="Fermer la fenêtre du dossier"
      >
        Fermer ✕
      </button>
    </header>

    <div id="modal-body" class="dossier-modal__body"></div>
  </div>
</dialog>
