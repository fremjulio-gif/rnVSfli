---
import BaseLayout from '../layouts/BaseLayout.astro';
import VsArena from '../components/VsArena.astro';
import RadarChart from '../components/RadarChart.astro';
import TimelineChart from '../components/TimelineChart.astro';
import CaseExplorer from '../components/CaseExplorer.astro';
import CaseModal from '../components/CaseModal.astro';
import {
  FIGHTERS_ROSTER,
  buildIssueReportUrl,
  computeCampMetrics,
  loadDataset,
} from '../lib/data';
import { formatDateFr, getDict } from '../i18n';

const dataset = loadDataset();
const dict = getDict('fr');

const lfiMetrics = computeCampMetrics(dataset.cases, 'LFI');
const rnMetrics = computeCampMetrics(dataset.cases, 'RN');

// Prépare les données sérialisées pour l'interactivité client (HUD %, frise, vue liste, modale)
const clientCases = dataset.cases.map((c) => ({
  ...c,
  statutLabel: dict.statuts[c.statut].label,
  statutPlain: dict.statuts[c.statut].plain,
  statutGlyph: dict.statuts[c.statut].glyph,
  statutTone: dict.statuts[c.statut].tone,
  categorieLabel: dict.categories[c.categorie].label,
  dateDisplay: formatDateFr(c.date_derniere_decision),
  verifiedDisplay: formatDateFr(c.verified_at),
  datesFormatted: c.dates_cles.map((d) => ({
    date: formatDateFr(d.date),
    libelle: d.libelle,
  })),
  sourcesFormatted: c.sources.map((s) => ({
    ...s,
    consulted: formatDateFr(s.date_consultation),
  })),
  reportUrl: buildIssueReportUrl(c, dict.site.repoIssuesUrl),
}));

const clientPayload = {
  metrics: {
    LFI: lfiMetrics,
    RN: rnMetrics,
  },
  fighters: FIGHTERS_ROSTER,
  cases: clientCases,
};
---

<BaseLayout currentPath="/">
  <!-- 1. ARÈNE VS PLEIN CADRE (MÉLENCHON + DÉPUTÉS VS LE PEN + DÉPUTÉS + % HUD) -->
  <VsArena lfiMetrics={lfiMetrics} rnMetrics={rnMetrics} cases={dataset.cases} />

  <!-- REPÈRES DE LECTURE POUR TOUS + GLOSSAIRE JURIDIQUE EN FRANÇAIS SIMPLE -->
  <section class="intro-guide-wrap" aria-labelledby="guide-heading">
    <div class="container">
      <div class="disclaimer-banner" role="note" aria-label="Avertissement juridique">
        <strong>Information importante :</strong> {dict.site.disclaimer}
      </div>

      <h2 id="guide-heading" class="guide-section-title">
        Comment lire ce comparateur (en 3 points)
      </h2>

      <div class="guide-grid">
        {
          dict.guide.map((item) => (
            <article class="pixel-frame guide-card">
              <div class="guide-card__head">
                <span class="guide-card__num" aria-hidden="true">{item.step}</span>
                <h3 class="guide-card__title">{item.title}</h3>
              </div>
              <p class="guide-card__body">{item.body}</p>
            </article>
          ))
        }
      </div>

      <details class="pixel-frame glossary-box">
        <summary class="glossary-summary">
          Comprendre les mots de la justice (guide rapide en 6 notions)
        </summary>
        <div class="glossary-grid">
          {
            dict.glossary.map((entry) => (
              <div class="glossary-item">
                <h4>{entry.term}</h4>
                <p>{entry.definition}</p>
              </div>
            ))
          }
        </div>
      </details>
    </div>
  </section>

  <!-- 2. TABLEAU DE BORD DATAVIZ (RADAR + BARRES EMPILÉES + FRISE / LISTE 2010–2026) -->
  <section id="dataviz-dashboard" class="section-block" aria-labelledby="dataviz-heading">
    <div class="container">
      <header class="section-header">
        <span class="section-kicker">VUE D'ENSEMBLE · PÉRIODE 2010–2026</span>
        <h2 id="dataviz-heading" class="section-title">
          Profils comparés et chronologie 2010–2026
        </h2>
        <p class="section-desc">
          Période étudiée de façon symétrique des deux côtés : présidence de Marine Le Pen dès
          janvier 2011 pour le FN devenu RN ; Parti de Gauche et Front de Gauche (2010–2015) puis
          LFI (créée en 2016) autour de Jean-Luc Mélenchon.
        </p>
      </header>

      <RadarChart lfiMetrics={lfiMetrics} rnMetrics={rnMetrics} />
      <TimelineChart cases={dataset.cases} />
    </div>
  </section>

  <!-- 3. EXPLORATEUR PAR THÈMES + SECTION SÉPARÉE PROCÉDURES EN COURS -->
  <CaseExplorer cases={dataset.cases} />

  <!-- Ancre directe vers l'onglet Procédures en cours -->
  <div id="procedures-en-cours" class="visually-hidden" aria-hidden="true"></div>

  <!-- 4. ÉCRAN FINAL NEUTRE -->
  <section class="section-block" aria-labelledby="ending-heading">
    <div class="container">
      <div class="pixel-frame ending-box">
        <span class="section-kicker">ESSENTIEL À RETENIR</span>
        <h2 id="ending-heading" class="section-title">
          Aucun vainqueur : comment lire ces données
        </h2>
        <p style="margin: 0; color: var(--ink-muted);">{dict.ending.subhead}</p>
        <ol class="ending-list">
          {dict.ending.points.map((pt) => <li>{pt}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <CaseModal />

  <script id="versus-payload" type="application/json" set:html={JSON.stringify(clientPayload)} />

  <script>
    import { arcadeSynth } from '../scripts/sound';

    interface ClientCase {
      id: string;
      camp: 'LFI' | 'RN';
      categorie: string;
      categorieLabel: string;
      section: string;
      statut: string;
      statutLabel: string;
      statutPlain: string;
      statutGlyph: string;
      statutTone: string;
      entite_principale: string;
      titre: string;
      qualification_legale: string;
      resume_factuel: string;
      juridiction: string;
      dateDisplay: string;
      verifiedDisplay: string;
      datesFormatted: { date: string; libelle: string }[];
      peine?: {
        prison?: string;
        amende?: string;
        ineligibilite?: string;
        execution_provisoire?: string;
        autres?: string;
        note_recours: string;
      } | null;
      references_judiciaires: string[];
      confirmation_primaire: string;
      motif_absence_source_primaire?: string;
      sourcesFormatted: {
        url: string;
        type: 'primaire' | 'presse';
        titre: string;
        editeur: string;
        date_publication: string;
        consulted: string;
      }[];
      fighter_slugs: string[];
      reportUrl: string;
    }

    interface CampMetric {
      totalCases: number;
      definitiveConvictions: number;
      definitivePct: number;
      pendingConvictions: number;
      pendingPct: number;
      clearedCount: number;
      clearedPct: number;
      ongoingCount: number;
      ongoingPct: number;
    }

    interface Fighter {
      slug: string;
      camp: 'LFI' | 'RN';
      name: string;
      role: string;
    }

    const rawJson = document.getElementById('versus-payload')?.textContent ?? '{}';
    const payload = JSON.parse(rawJson) as {
      metrics: { LFI: CampMetric; RN: CampMetric };
      fighters: Fighter[];
      cases: ClientCase[];
    };

    function escapeHtml(text: string): string {
      return text
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    function formatDossierRecense(count: number): string {
      return count <= 1 ? `${count} dossier recensé` : `${count} dossiers recensés`;
    }

    // 1. HUD % switcher
    const hudLfiPct = document.getElementById('hud-lfi-pct');
    const hudRnPct = document.getElementById('hud-rn-pct');
    const hudLfiBar = document.getElementById('hud-lfi-bar');
    const hudRnBar = document.getElementById('hud-rn-bar');
    const hudLfiRatio = document.getElementById('hud-lfi-ratio');
    const hudRnRatio = document.getElementById('hud-rn-ratio');
    const hudCaption = document.getElementById('hud-metric-caption');

    const metricMeta: Record<
      string,
      { caption: string; pick: (m: CampMetric) => { count: number; pct: number } }
    > = {
      definitive: {
        caption:
          'Part des dossiers recensés (2010–2026) ayant abouti à une condamnation définitive (tous recours épuisés). Aucun score de gravité.',
        pick: (m) => ({ count: m.definitiveConvictions, pct: m.definitivePct }),
      },
      pending: {
        caption:
          'Part des condamnations prononcées en 1re instance ou en appel qui font l’objet d’un recours (ou sont encore susceptibles de recours) : les personnes restent présumées innocentes.',
        pick: (m) => ({ count: m.pendingConvictions, pct: m.pendingPct }),
      },
      cleared: {
        caption:
          'Part des dossiers terminés sans condamnation : relaxe par le tribunal, non-lieu, classement sans suite ou prescription.',
        pick: (m) => ({ count: m.clearedCount, pct: m.clearedPct }),
      },
      ongoing: {
        caption:
          'Part des enquêtes, informations judiciaires, mises en examen ou renvois sans jugement définitif : aucune culpabilité n’est établie (présomption d’innocence).',
        pick: (m) => ({ count: m.ongoingCount, pct: m.ongoingPct }),
      },
    };

    document.querySelectorAll<HTMLButtonElement>('.hud-metric-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.metric ?? 'definitive';
        const spec = metricMeta[key] ?? metricMeta.definitive;
        const lfiVal = spec.pick(payload.metrics.LFI);
        const rnVal = spec.pick(payload.metrics.RN);

        document.querySelectorAll<HTMLButtonElement>('.hud-metric-btn').forEach((b) => {
          b.setAttribute('aria-pressed', String(b === btn));
        });

        if (hudLfiPct) hudLfiPct.textContent = `${lfiVal.pct}%`;
        if (hudRnPct) hudRnPct.textContent = `${rnVal.pct}%`;
        if (hudLfiBar) hudLfiBar.style.transform = `scaleX(${lfiVal.pct / 100})`;
        if (hudRnBar) hudRnBar.style.transform = `scaleX(${rnVal.pct / 100})`;
        if (hudLfiRatio)
          hudLfiRatio.textContent = `${lfiVal.count} sur ${payload.metrics.LFI.totalCases} dossiers recensés`;
        if (hudRnRatio)
          hudRnRatio.textContent = `${rnVal.count} sur ${payload.metrics.RN.totalCases} dossiers recensés`;
        if (hudCaption) hudCaption.textContent = spec.caption;

        arcadeSynth.play('uiConfirm');
        arcadeSynth.vibrate(10);
      });
    });

    // 2. Modale dossier complet
    const modal = document.getElementById('dossier-modal') as HTMLDialogElement | null;
    const modalTitle = document.getElementById('modal-title');
    const modalKicker = document.getElementById('modal-kicker');
    const modalBody = document.getElementById('modal-body');
    const modalClose = document.getElementById('modal-close-btn');

    function renderCaseHtml(c: ClientCase): string {
      const peineParts: string[] = [];
      if (c.peine) {
        if (c.peine.prison)
          peineParts.push(`<p style="margin:0 0 0.35rem;"><strong>Peine de prison :</strong> ${escapeHtml(c.peine.prison)}</p>`);
        if (c.peine.amende)
          peineParts.push(`<p style="margin:0 0 0.35rem;"><strong>Amende ou confiscation :</strong> ${escapeHtml(c.peine.amende)}</p>`);
        if (c.peine.ineligibilite)
          peineParts.push(`<p style="margin:0 0 0.35rem;"><strong>Inéligibilité (interdiction de se présenter aux élections) :</strong> ${escapeHtml(c.peine.ineligibilite)}</p>`);
        if (c.peine.execution_provisoire)
          peineParts.push(`<p style="margin:0 0 0.35rem;"><strong>Application immédiate (exécution provisoire) :</strong> ${escapeHtml(c.peine.execution_provisoire)}</p>`);
        if (c.peine.autres)
          peineParts.push(`<p style="margin:0 0 0.35rem;"><strong>Autres mesures :</strong> ${escapeHtml(c.peine.autres)}</p>`);
        peineParts.push(`<p style="margin:0;"><strong>Recours possibles ou en cours :</strong> ${escapeHtml(c.peine.note_recours)}</p>`);
      }

      const datesHtml = c.datesFormatted
        .map((d) => `<li><strong>${escapeHtml(d.date)} :</strong> ${escapeHtml(d.libelle)}</li>`)
        .join('');

      const sourcesHtml = c.sourcesFormatted
        .map(
          (s) =>
            `<li><span class="source-tag source-tag--${s.type}">${s.type === 'primaire' ? 'SOURCE OFFICIELLE' : 'PRESSE'}</span>` +
            `<a href="${escapeHtml(s.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(s.titre)}</a> ` +
            `<span style="color:var(--ink-muted);">(${escapeHtml(s.editeur)}, ${escapeHtml(s.date_publication)} — vérifié le ${escapeHtml(s.consulted)})</span></li>`,
        )
        .join('');

      return `
        <article class="modal-case-item" data-camp="${c.camp}">
          <div class="case-card__top">
            <span class="status-badge status-badge--${c.statutTone}">
              <span aria-hidden="true">${escapeHtml(c.statutGlyph)}</span>
              <span>${escapeHtml(c.statutLabel)}</span>
            </span>
            <span class="entity-pill">${escapeHtml(c.camp)} · ${escapeHtml(c.categorieLabel)}</span>
          </div>
          <div class="modal-status-help">
            <strong>En clair :</strong> ${escapeHtml(c.statutPlain)}
          </div>
          <h3 style="margin:0; font-size:1.08rem;">${escapeHtml(c.titre)}</h3>
          <p style="margin:0; font-size:0.94rem; color:var(--ink-muted);">
            <strong>Personne(s) ou organisation :</strong> ${escapeHtml(c.entite_principale)}<br/>
            <strong>Infraction juridique :</strong> ${escapeHtml(c.qualification_legale)}<br/>
            <strong>Tribunal / Juridiction :</strong> ${escapeHtml(c.juridiction)} · <strong>Dernière date connue :</strong> ${escapeHtml(c.dateDisplay)}
          </p>
          <p style="margin:0; font-size:0.98rem;">${escapeHtml(c.resume_factuel)}</p>
          ${peineParts.length ? `<div class="modal-peine-box">${peineParts.join('')}</div>` : ''}
          <div>
            <strong style="font-size:0.9rem; color:var(--ink-primary);">DATES CLÉS DE LA PROCÉDURE</strong>
            <ul class="timeline-mini">${datesHtml}</ul>
          </div>
          <div>
            <strong style="font-size:0.9rem; color:var(--ink-primary);">PREUVES ET SOURCES (${c.sourcesFormatted.length}) — ${c.confirmation_primaire === 'confirme' ? 'Décision officielle directe vérifiée' : 'Presse de référence et institutions'}</strong>
            ${c.motif_absence_source_primaire ? `<p style="margin:0.35rem 0; font-size:0.88rem; color:var(--ink-muted);">${escapeHtml(c.motif_absence_source_primaire)}</p>` : ''}
            <ul class="sources-list">${sourcesHtml}</ul>
          </div>
          <div class="compact-case__actions">
            <span style="font-size:0.88rem; color:var(--ink-muted);">Vérifié le ${escapeHtml(c.verifiedDisplay)}</span>
            <a href="${escapeHtml(c.reportUrl)}" target="_blank" rel="noopener noreferrer" style="font-size:0.92rem; font-weight:700;">Signaler une erreur →</a>
          </div>
        </article>
      `;
    }

    function openCaseModal(caseId: string) {
      const found = payload.cases.find((c) => c.id === caseId);
      if (!found || !modal || !modalBody || !modalTitle || !modalKicker) return;
      modalKicker.textContent = `${found.camp} · ${found.categorieLabel}`;
      modalTitle.textContent = found.titre;
      modalBody.innerHTML = renderCaseHtml(found);
      arcadeSynth.play('roundTransition');
      arcadeSynth.vibrate(12);
      modal.showModal();
    }

    function openFighterModal(slug: string) {
      const fighter = payload.fighters.find((f) => f.slug === slug);
      if (!fighter || !modal || !modalBody || !modalTitle || !modalKicker) return;
      const list = payload.cases.filter((c) => c.fighter_slugs.includes(slug));
      modalKicker.textContent = `${fighter.camp} · ${fighter.role}`;
      modalTitle.textContent = `${fighter.name} — ${formatDossierRecense(list.length)}`;
      modalBody.innerHTML =
        list.length > 0
          ? list.map(renderCaseHtml).join('')
          : '<p>Aucun dossier lié dans le périmètre retenu.</p>';
      arcadeSynth.play('roundTransition');
      arcadeSynth.vibrate(14);
      modal.showModal();
    }

    modalClose?.addEventListener('click', () => {
      modal?.close();
      arcadeSynth.play('uiSelect');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    document.querySelectorAll<HTMLElement>('[data-open-case]').forEach((el) => {
      const handler = () => {
        const id = el.dataset.openCase;
        if (id) openCaseModal(id);
      };
      el.addEventListener('click', handler);
      if (el.tagName !== 'BUTTON') {
        el.addEventListener('keydown', (ev: KeyboardEvent) => {
          if (ev.key === 'Enter' || ev.key === ' ') {
            ev.preventDefault();
            handler();
          }
        });
      }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-open-fighter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.openFighter;
        if (slug) openFighterModal(slug);
      });
    });

    // 3. Frise SVG + Vue liste facile à lire : survol, bascule de vue et filtres synchronisés
    const hoverBanner = document.getElementById('timeline-hover-banner');
    const cCamp = document.getElementById('chart-filter-camp') as HTMLSelectElement | null;
    const cStatut = document.getElementById('chart-filter-statut') as HTMLSelectElement | null;
    const cCat = document.getElementById('chart-filter-cat') as HTMLSelectElement | null;
    const cCount = document.getElementById('chart-visible-count');
    const nodes = Array.from(document.querySelectorAll<SVGGElement>('.timeline-node'));
    const listItems = Array.from(document.querySelectorAll<HTMLElement>('.timeline-list-item'));
    const listEmpty = document.getElementById('timeline-list-empty');
    const btnViewGraph = document.getElementById('timeline-view-graph') as HTMLButtonElement | null;
    const btnViewList = document.getElementById('timeline-view-list') as HTMLButtonElement | null;
    const panelGraph = document.getElementById('timeline-graph-panel');
    const panelList = document.getElementById('timeline-list-view');

    function setTimelineView(mode: 'graph' | 'list') {
      const isList = mode === 'list';
      if (panelGraph) panelGraph.hidden = isList;
      if (panelList) panelList.hidden = !isList;
      btnViewGraph?.setAttribute('aria-pressed', String(!isList));
      btnViewList?.setAttribute('aria-pressed', String(isList));
    }

    btnViewGraph?.addEventListener('click', () => {
      setTimelineView('graph');
      arcadeSynth.play('uiSelect');
      arcadeSynth.vibrate(8);
    });

    btnViewList?.addEventListener('click', () => {
      setTimelineView('list');
      arcadeSynth.play('uiSelect');
      arcadeSynth.vibrate(8);
    });

    nodes.forEach((node) => {
      const showTip = () => {
        if (hoverBanner && node.dataset.tip) {
          hoverBanner.textContent = node.dataset.tip;
        }
      };
      node.addEventListener('mouseenter', showTip);
      node.addEventListener('focus', showTip);
    });

    function matchesTimelineFilters(el: Element): boolean {
      const camp = cCamp?.value ?? 'ALL';
      const st = cStatut?.value ?? 'ALL';
      const cat = cCat?.value ?? 'ALL';
      const ds = (el as HTMLElement | SVGElement).dataset;
      return (
        (camp === 'ALL' || ds.camp === camp) &&
        (st === 'ALL' || ds.statut === st) &&
        (cat === 'ALL' || ds.categorie === cat)
      );
    }

    function filterChart() {
      let visible = 0;

      for (const n of nodes) {
        if (matchesTimelineFilters(n)) {
          n.removeAttribute('hidden');
          visible += 1;
        } else {
          n.setAttribute('hidden', 'true');
        }
      }

      for (const item of listItems) {
        item.hidden = !matchesTimelineFilters(item);
      }

      if (listEmpty) {
        listEmpty.hidden = visible > 0;
      }

      if (cCount) {
        const label = visible <= 1 ? 'dossier' : 'dossiers';
        cCount.textContent = `${visible} / ${nodes.length} ${label}`;
      }
    }

    [cCamp, cStatut, cCat].forEach((sel) => {
      sel?.addEventListener('change', () => {
        arcadeSynth.play('filterTick');
        filterChart();
      });
    });

    // 4. Onglets des Thèmes
    const tabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.round-tab-btn'));
    const tabPanels = Array.from(document.querySelectorAll<HTMLElement>('.round-panel'));

    function activateTab(targetKey: string) {
      tabBtns.forEach((b) => {
        const isTarget = b.dataset.tabTarget === targetKey;
        b.setAttribute('aria-selected', String(isTarget));
      });
      tabPanels.forEach((p) => {
        p.hidden = p.id !== `panel-${targetKey}`;
      });
    }

    tabBtns.forEach((b) => {
      b.addEventListener('click', () => {
        const target = b.dataset.tabTarget;
        if (!target) return;
        activateTab(target);
        arcadeSynth.play('uiSelect');
        arcadeSynth.vibrate(8);
      });
    });

    // Ouvre l'onglet Procédures en cours si clic sur l'ancre #procedures-en-cours
    document.querySelectorAll('a[href="#procedures-en-cours"]').forEach((link) => {
      link.addEventListener('click', (ev) => {
        ev.preventDefault();
        activateTab('procedures_en_cours');
        document.getElementById('explorer-rounds')?.scrollIntoView({ behavior: 'smooth' });
      });
    });
  </script>
</BaseLayout>
