---
import { CATEGORIE_VALUES } from '../lib/schema';
import { getDict } from '../i18n';

const dict = getDict('fr');
const tabs = [
  ...CATEGORIE_VALUES.map((cat) => ({
    key: cat as string,
    kicker: dict.categories[cat].round,
    label: dict.categories[cat].label,
  })),
  { key: 'procedures_en_cours', kicker: 'EN COURS', label: 'Procédures en cours (présumés innocents)' },
];
---

<section id="explorer-rounds" class="section-block" aria-labelledby="explorer-heading">
  <div class="container">
    <header class="section-header">
      <span class="section-kicker">EXPLORER PAR THÈME · 2010–2026</span>
      <h2 id="explorer-heading" class="section-title">Tous les dossiers, classés par thème</h2>
      <p class="section-desc" id="explorer-desc">
        Choisissez un thème (ou l'onglet séparé des procédures en cours), puis cliquez sur « Lire le
        dossier complet » pour voir les dates, les peines et les liens officiels.
      </p>
    </header>

    <div class="round-tabs" role="tablist" aria-label="Thèmes judiciaires">
      {tabs.map((t, i) => (
        <button type="button" role="tab" id={`tab-${t.key}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls="explorer-panel" class="round-tab-btn" data-tab-target={t.key}>
          <span class="round-tab-btn__kicker">{t.kicker}</span>
          <span>{t.label}</span>
          <span class="round-tab-btn__count" id={`tab-count-${t.key}`}>(0)</span>
        </button>
      ))}
    </div>

    <div id="explorer-panel" role="tabpanel" class="round-panel" aria-live="polite"></div>
  </div>
</section>
