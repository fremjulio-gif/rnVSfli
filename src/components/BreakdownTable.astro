---
import type { CampBreakdown } from '../lib/data';
import { CATEGORIE_VALUES, STATUT_DECISIONS, STATUT_PROCEDURES_EN_COURS } from '../lib/schema';
import { getDict } from '../i18n';

interface Props {
  breakdown: CampBreakdown;
}

const { breakdown } = Astro.props;
const dict = getDict('fr');
---

<div class="breakdown-block">
  <h3 class="breakdown-title">DÉCISIONS RENDUES — PAR STATUT</h3>
  <ul class="stat-list">
    {
      STATUT_DECISIONS.map((statusKey) => (
        <li class="stat-row">
          <span>
            <span aria-hidden="true">{dict.statuts[statusKey].glyph}</span>{' '}
            {dict.statuts[statusKey].label}
          </span>
          <span class="stat-count" data-countup={breakdown.decisionsByStatus[statusKey]}>
            {breakdown.decisionsByStatus[statusKey]}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<div class="breakdown-block">
  <h3 class="breakdown-title">DÉCISIONS RENDUES — PAR CATÉGORIE PÉNALE</h3>
  <ul class="stat-list">
    {
      CATEGORIE_VALUES.map((catKey) => (
        <li class="stat-row">
          <span>{dict.categories[catKey].label}</span>
          <span class="stat-count" data-countup={breakdown.decisionsByCategory[catKey]}>
            {breakdown.decisionsByCategory[catKey]}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<div class="breakdown-block">
  <h3 class="breakdown-title">PROCÉDURES EN COURS (PRÉSUMÉS INNOCENTS)</h3>
  <ul class="stat-list">
    {
      STATUT_PROCEDURES_EN_COURS.map((statusKey) => (
        <li class="stat-row">
          <span>
            <span aria-hidden="true">{dict.statuts[statusKey].glyph}</span>{' '}
            {dict.statuts[statusKey].label}
          </span>
          <span class="stat-count" data-countup={breakdown.ongoingByStatus[statusKey]}>
            {breakdown.ongoingByStatus[statusKey]}
          </span>
        </li>
      ))
    }
  </ul>
</div>
