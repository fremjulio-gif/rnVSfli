---
import type { CampMetrics } from '../lib/data';

interface Props {
  lfiMetrics: CampMetrics;
  rnMetrics: CampMetrics;
}

const { lfiMetrics, rnMetrics } = Astro.props;

const axes = [
  {
    label: 'Financement',
    lfi: lfiMetrics.byCategoryAll.financement_probite,
    rn: rnMetrics.byCategoryAll.financement_probite,
  },
  {
    label: 'Presse / Expr.',
    lfi: lfiMetrics.byCategoryAll.presse_expression,
    rn: rnMetrics.byCategoryAll.presse_expression,
  },
  {
    label: 'Ordre public',
    lfi: lfiMetrics.byCategoryAll.ordre_public_biens,
    rn: rnMetrics.byCategoryAll.ordre_public_biens,
  },
  {
    label: 'Cond. définitives',
    lfi: lfiMetrics.definitiveConvictions,
    rn: rnMetrics.definitiveConvictions,
  },
  {
    label: 'En cours / Recours',
    lfi: lfiMetrics.ongoingCount + lfiMetrics.pendingConvictions,
    rn: rnMetrics.ongoingCount + rnMetrics.pendingConvictions,
  },
];

const maxAxis = Math.max(
  1,
  ...axes.flatMap((a) => [a.lfi, a.rn]),
);

const cx = 230;
const cy = 160;
const radius = 92;

function polarPoint(index: number, valueRatio: number): { x: number; y: number } {
  const angle = -Math.PI / 2 + (index * 2 * Math.PI) / axes.length;
  const r = radius * valueRatio;
  return {
    x: Number((cx + r * Math.cos(angle)).toFixed(1)),
    y: Number((cy + r * Math.sin(angle)).toFixed(1)),
  };
}

function buildPolygon(values: number[]): string {
  return values
    .map((v, i) => {
      const pt = polarPoint(i, v / maxAxis);
      return `${pt.x},${pt.y}`;
    })
    .join(' ');
}

const lfiPoly = buildPolygon(axes.map((a) => a.lfi));
const rnPoly = buildPolygon(axes.map((a) => a.rn));
const rings = [0.25, 0.5, 0.75, 1];

const totalLfi = Math.max(1, lfiMetrics.totalCases);
const totalRn = Math.max(1, rnMetrics.totalCases);
---

<div class="dataviz-grid">
  <!-- RADAR MULTI-AXES -->
  <section class="pixel-frame dataviz-card" aria-labelledby="radar-heading">
    <div class="dataviz-card__head">
      <span class="section-kicker">RADAR · PROFILS COMPARÉS (2010–2026)</span>
      <h3 id="radar-heading" class="dataviz-card__title">FIGHTER STATS — RÉPARTITION PAR NATURE</h3>
    </div>

    <div class="radar-wrap">
      <svg
        viewBox="0 0 460 320"
        class="radar-svg"
        role="img"
        aria-label="Graphique radar comparant le nombre de dossiers LFI et RN sur 5 axes : financement, presse, ordre public, condamnations définitives et dossiers en cours ou sous recours."
      >
        {
          rings.map((ratio) => (
            <polygon
              points={axes
                .map((_, i) => {
                  const pt = polarPoint(i, ratio);
                  return `${pt.x},${pt.y}`;
                })
                .join(' ')}
              fill="none"
              stroke="rgba(163, 177, 204, 0.25)"
              stroke-width="1"
            />
          ))
        }

        {
          axes.map((axis, i) => {
            const edge = polarPoint(i, 1);
            const labelPt = polarPoint(i, 1.24);
            const anchor =
              labelPt.x < cx - 15 ? 'end' : labelPt.x > cx + 15 ? 'start' : 'middle';
            return (
              <g>
                <line
                  x1={cx}
                  y1={cy}
                  x2={edge.x}
                  y2={edge.y}
                  stroke="rgba(163, 177, 204, 0.35)"
                  stroke-width="1"
                />
                <text
                  x={labelPt.x}
                  y={labelPt.y}
                  text-anchor={anchor}
                  fill="#F2F5FA"
                  font-size="9.5"
                  font-family="IBM Plex Mono, monospace"
                >
                  {axis.label}
                </text>
              </g>
            );
          })
        }

        <polygon
          points={lfiPoly}
          fill="rgba(245, 183, 59, 0.24)"
          stroke="#F5B73B"
          stroke-width="2.5"
        />
        <polygon
          points={rnPoly}
          fill="rgba(76, 201, 240, 0.22)"
          stroke="#4CC9F0"
          stroke-width="2.5"
        />

        {
          axes.map((axis, i) => {
            const pLfi = polarPoint(i, axis.lfi / maxAxis);
            const pRn = polarPoint(i, axis.rn / maxAxis);
            return (
              <g>
                <circle cx={pLfi.x} cy={pLfi.y} r="3.5" fill="#F5B73B" />
                <circle cx={pRn.x} cy={pRn.y} r="3.5" fill="#4CC9F0" />
              </g>
            );
          })
        }
      </svg>

      <div class="radar-legend">
        <span class="legend-chip legend-chip--lfi">■ LFI / FDG ({lfiMetrics.totalCases} fiches)</span>
        <span class="legend-chip legend-chip--rn">■ RN ex-FN ({rnMetrics.totalCases} fiches)</span>
      </div>
    </div>
  </section>

  <!-- BARRES EMPILÉES & PERSONNE MORALE VS PHYSIQUE -->
  <section class="pixel-frame dataviz-card" aria-labelledby="bars-heading">
    <div class="dataviz-card__head">
      <span class="section-kicker">VENTILATION · STATUTS &amp; ENTITÉS</span>
      <h3 id="bars-heading" class="dataviz-card__title">DÉCISIONS, RECOURS &amp; PERSONNES MORALES</h3>
    </div>

    <div class="stacked-block">
      <div class="stacked-label-row">
        <strong style="color: var(--camp-lfi);">LFI / FDG ({lfiMetrics.totalCases})</strong>
        <span>Définitif: {lfiMetrics.definitiveConvictions} · Recours: {lfiMetrics.pendingConvictions} · Relaxe/Classé: {lfiMetrics.clearedCount} · En cours: {lfiMetrics.ongoingCount}</span>
      </div>
      <div class="stacked-bar" aria-label="Répartition par statut LFI">
        <span class="seg seg--def" style={`width: ${(lfiMetrics.definitiveConvictions / totalLfi) * 100}%`} title={`Condamnations définitives: ${lfiMetrics.definitiveConvictions}`}></span>
        <span class="seg seg--pend" style={`width: ${(lfiMetrics.pendingConvictions / totalLfi) * 100}%`} title={`Sous recours: ${lfiMetrics.pendingConvictions}`}></span>
        <span class="seg seg--clear" style={`width: ${(lfiMetrics.clearedCount / totalLfi) * 100}%`} title={`Relaxes / classés: ${lfiMetrics.clearedCount}`}></span>
        <span class="seg seg--ong" style={`width: ${(lfiMetrics.ongoingCount / totalLfi) * 100}%`} title={`En cours: ${lfiMetrics.ongoingCount}`}></span>
      </div>

      <div class="stacked-label-row" style="margin-top: 0.9rem;">
        <strong style="color: var(--camp-rn);">RN ex-FN ({rnMetrics.totalCases})</strong>
        <span>Définitif: {rnMetrics.definitiveConvictions} · Recours: {rnMetrics.pendingConvictions} · Relaxe/Classé: {rnMetrics.clearedCount} · En cours: {rnMetrics.ongoingCount}</span>
      </div>
      <div class="stacked-bar" aria-label="Répartition par statut RN">
        <span class="seg seg--def" style={`width: ${(rnMetrics.definitiveConvictions / totalRn) * 100}%`} title={`Condamnations définitives: ${rnMetrics.definitiveConvictions}`}></span>
        <span class="seg seg--pend" style={`width: ${(rnMetrics.pendingConvictions / totalRn) * 100}%`} title={`Sous recours: ${rnMetrics.pendingConvictions}`}></span>
        <span class="seg seg--clear" style={`width: ${(rnMetrics.clearedCount / totalRn) * 100}%`} title={`Relaxes / classés: ${rnMetrics.clearedCount}`}></span>
        <span class="seg seg--ong" style={`width: ${(rnMetrics.ongoingCount / totalRn) * 100}%`} title={`En cours: ${rnMetrics.ongoingCount}`}></span>
      </div>

      <div class="seg-legend">
        <span><i class="swatch swatch--def"></i> Définitif</span>
        <span><i class="swatch swatch--pend"></i> Sous recours</span>
        <span><i class="swatch swatch--clear"></i> Relaxe / Classé</span>
        <span><i class="swatch swatch--ong"></i> Procédure en cours</span>
      </div>
    </div>

    <div class="entity-split-grid">
      <div class="entity-split-box">
        <div class="entity-split-box__title" style="color: var(--camp-lfi);">LFI — TYPE D'ENTITÉ</div>
        <div class="entity-split-row">
          <span>Impliquant personne morale / parti</span>
          <strong>{lfiMetrics.moraleInvolvedCount}</strong>
        </div>
        <div class="entity-split-row">
          <span>Personne physique uniquement</span>
          <strong>{lfiMetrics.physiqueOnlyCount}</strong>
        </div>
      </div>

      <div class="entity-split-box">
        <div class="entity-split-box__title" style="color: var(--camp-rn);">RN — TYPE D'ENTITÉ</div>
        <div class="entity-split-row">
          <span>Impliquant personne morale / parti</span>
          <strong>{rnMetrics.moraleInvolvedCount}</strong>
        </div>
        <div class="entity-split-row">
          <span>Personne physique uniquement</span>
          <strong>{rnMetrics.physiqueOnlyCount}</strong>
        </div>
      </div>
    </div>
  </section>
</div>
