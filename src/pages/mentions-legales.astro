---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FIGHTERS_ROSTER } from '../lib/data';
import { getDict } from '../i18n';

const dict = getDict('fr');
---

<BaseLayout
  currentPath="/mentions-legales"
  title="Mentions légales & Crédits — VERSUS"
  description="Mentions légales, éditeur, hébergeur, droit de réponse, RGPD et crédits photographiques Wikimedia Commons."
>
  <div class="container prose-page">
    <h1 class="pixel-title" style="font-size: clamp(1rem, 3vw, 1.5rem); margin-bottom: 1.25rem;">
      MENTIONS LÉGALES, DROIT DE RÉPONSE &amp; CRÉDITS
    </h1>

    <section class="pixel-frame prose-card">
      <h2>1. Éditeur du site (LCEN)</h2>
      <p>
        Projet open source indépendant publié via le compte GitHub{' '}
        <a href="https://github.com/fremjulio-gif/rnVSfli" target="_blank" rel="noopener noreferrer">
          fremjulio-gif/rnVSfli
        </a>.
      </p>
      <p style="color: var(--ink-muted); font-size: 0.85rem;">
        Note LCEN (art. 6 III de la loi n° 2004-575 du 21 juin 2004) : avant toute diffusion grand
        public, l'éditeur complète ses coordonnées légales ou relève du régime non professionnel
        via l'hébergeur (art. 6 III-2 LCEN).
      </p>
    </section>

    <section class="pixel-frame prose-card">
      <h2>2. Hébergement</h2>
      <p>
        <strong>Vercel Inc.</strong> — 440 N Barranca Ave #4133, Covina, CA 91723, États-Unis —{' '}
        <a href="https://vercel.com" target="_blank" rel="noopener noreferrer">https://vercel.com</a>.
      </p>
    </section>

    <section class="pixel-frame prose-card">
      <h2>3. Avertissement éditorial &amp; droit de rectification</h2>
      <p>{dict.site.disclaimer}</p>
      <p>
        Toute personne mentionnée ou tout lecteur peut signaler une erreur ou demander une mise à
        jour procédurale :
      </p>
      <p>
        <a
          class="arcade-btn"
          href={dict.site.repoIssuesUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Signaler une erreur / Droit de rectification
        </a>
      </p>
    </section>

    <section class="pixel-frame prose-card">
      <h2>4. Crédits photographiques (Wikimedia Commons) &amp; droit à l'image</h2>
      <p style="font-size: 0.85rem; color: var(--ink-muted);">
        Les portraits présentés illustrent exclusivement des responsables politiques publics dans le
        cadre du droit à l'information sur des procédures judiciaires d'intérêt général. Chaque
        image provient de Wikimedia Commons sous licence libre (détourage local sans altération
        dégradante).
      </p>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Personnalité</th>
              <th>Camp</th>
              <th>Auteur / Source</th>
              <th>Licence</th>
              <th>Fichier original</th>
            </tr>
          </thead>
          <tbody>
            {
              FIGHTERS_ROSTER.map((f) => (
                <tr>
                  <td>{f.name}</td>
                  <td>{f.camp}</td>
                  <td>{f.credit}</td>
                  <td>{f.license}</td>
                  <td>
                    <a href={f.sourcePage} target="_blank" rel="noopener noreferrer">
                      Wikimedia Commons
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="pixel-frame prose-card">
      <h2>5. Données personnelles (RGPD) &amp; polices</h2>
      <ul>
        <li>
          <strong>Cookies :</strong> aucun cookie publicitaire ni traceur analytique tiers.
        </li>
        <li>
          <strong>Polices &amp; audio :</strong> polices libres SIL OFL auto-hébergées (Press Start
          2P, IBM Plex Mono) ; sons Web Audio API 100 % synthétisés localement.
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
