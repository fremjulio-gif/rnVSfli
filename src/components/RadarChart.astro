---
const axesLines = [
  ['Financement', '& probité'],
  ['Presse &', 'expression'],
  ['Ordre public', '& biens'],
  ['Condamnations', 'définitives'],
  ['En cours ou', 'sous recours'],
];
const cx = 270;
const cy = 170;
const radius = 90;
function polar(i: number, r: number) {
  const a = -Math.PI / 2 + (i * 2 * Math.PI) / axesLines.length;
  return { x: +(cx + radius * r * Math.cos(a)).toFixed(1), y: +(cy + radius * r * Math.sin(a)).toFixed(1) };
}
const rings = [0.25, 0.5, 0.75, 1];
---

<div class="dataviz-grid">
  <section class="pixel-frame dataviz-card" aria-labelledby="radar-heading">
    <div class="dataviz-card__head">
      <span class="section-kicker">GRAPHIQUE COMPARATIF · 2010–2026</span>
      <h3 id="radar-heading" class="dataviz-card__title">Répartition des dossiers par thème et statut</h3>
    </div>

    <div id="radar-duel-view" class="radar-wrap">
      <svg viewBox="0 0 540 340" class="radar-svg" role="img" aria-label="Graphique radar comparant les deux partis du duel sur 5 critères.">
        {rings.map((r) => (
          <polygon points={axesLines.map((_, i) => { const p = polar(i, r); return `${p.x},${p.y}`; }).join(' ')} fill="none" stroke="rgba(184,197,220,0.25)" />
        ))}
        {axesLines.map((lines, i) => {
          const e = polar(i, 1);
          const l = polar(i, 1.24);
          const anchor = l.x < cx - 18 ? 'end' : l.x > cx + 18 ? 'start' : 'middle';
          const y0 = i === 0 ? l.y - 12 : l.y - 4;
          return (
            <g>
              <line x1={cx} y1={cy} x2={e.x} y2={e.y} stroke="rgba(184,197,220,0.35)" />
              <text x={l.x} y={y0} text-anchor={anchor} fill="#F2F5FA" font-size="12.5" font-weight="700" font-family="Atkinson Hyperlegible, system-ui, sans-serif">
                <tspan x={l.x} dy="0">{lines[0]}</tspan>
                <tspan x={l.x} dy="15">{lines[1]}</tspan>
              </text>
            </g>
          );
        })}
        <polygon id="radar-left-poly" points="" fill="rgba(245,183,59,0.24)" stroke="#F5B73B" stroke-width="2.5" />
        <polygon id="radar-right-poly" points="" fill="rgba(76,201,240,0.22)" stroke="#4CC9F0" stroke-width="2.5" />
        <g id="radar-dots"></g>
      </svg>
      <div class="radar-legend">
        <span class="legend-chip legend-chip--lfi" id="radar-legend-left">—</span>
        <span class="legend-chip legend-chip--rn" id="radar-legend-right">—</span>
      </div>
      <p class="radar-help">Plus la forme s'étend vers un sommet, plus le nombre de dossiers recensés dans ce domaine est élevé.</p>
    </div>

    <div id="radar-global-view" hidden>
      <div class="table-scroll">
        <table class="data-table global-compare-table">
          <caption class="visually-hidden">Nombre de dossiers par bloc politique et par critère</caption>
          <thead>
            <tr>
              <th scope="col">Bloc</th>
              <th scope="col">Financement & probité</th>
              <th scope="col">Presse & expression</th>
              <th scope="col">Ordre public & biens</th>
              <th scope="col">Condamnations définitives</th>
              <th scope="col">En cours ou sous recours</th>
              <th scope="col">Total</th>
            </tr>
          </thead>
          <tbody id="global-compare-body"></tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="pixel-frame dataviz-card" aria-labelledby="bars-heading">
    <div class="dataviz-card__head">
      <span class="section-kicker">RÉPARTITION DÉTAILLÉE · STATUTS ET ENTITÉS</span>
      <h3 id="bars-heading" class="dataviz-card__title">Décisions, recours et entités concernées</h3>
    </div>
    <div class="stacked-block" id="stacked-bars"></div>
    <div class="seg-legend">
      <span><i class="swatch swatch--def"></i> Condamnation définitive</span>
      <span><i class="swatch swatch--pend"></i> Condamnation sous recours</span>
      <span><i class="swatch swatch--clear"></i> Relaxe ou classement</span>
      <span><i class="swatch swatch--ong"></i> Procédure en cours</span>
    </div>
    <div class="entity-split-grid" id="entity-split"></div>
  </section>
</div>
