---
import { CATEGORIE_VALUES } from '../lib/schema';
import { PARTIES_ROSTER } from '../lib/data';
import { getDict } from '../i18n';

const dict = getDict('fr');
---

<section id="frise" class="pixel-frame dataviz-card" aria-labelledby="timeline-chart-heading">
  <div class="timeline-head-row">
    <div class="dataviz-card__head" style="margin-bottom: 0;">
      <span class="section-kicker">FRISE CHRONOLOGIQUE · 2010 → 2026</span>
      <h3 id="timeline-chart-heading" class="dataviz-card__title">Chronologie des dossiers</h3>
      <p class="section-desc" style="margin-top: 0.35rem;">
        Chaque repère correspond à la dernière décision ou étape connue au 26/11/2026. Touchez ou
        cliquez sur un dossier pour l'ouvrir, ou passez en « Vue liste » pour lire ligne par ligne.
      </p>
    </div>
    <div class="timeline-view-switch" role="group" aria-label="Mode d'affichage de la chronologie">
      <button type="button" id="timeline-view-graph" class="arcade-btn arcade-btn--sm" aria-pressed="true">Vue graphique (frise)</button>
      <button type="button" id="timeline-view-list" class="arcade-btn arcade-btn--sm" aria-pressed="false">Vue liste (lecture facile)</button>
    </div>
  </div>

  <div class="timeline-filter-bar" role="group" aria-label="Filtrer la chronologie">
    <label class="filter-chip-label">
      <span>Mouvement politique</span>
      <select id="chart-filter-camp" class="filter-input">
        <option value="DUEL">Les 2 partis du duel en cours</option>
        <option value="ALL">Tous les 6 partis</option>
        {PARTIES_ROSTER.map((p) => <option value={p.camp}>{p.fullName}</option>)}
      </select>
    </label>
    <label class="filter-chip-label">
      <span>Étape judiciaire</span>
      <select id="chart-filter-statut" class="filter-input">
        <option value="ALL">Toutes les étapes</option>
        {Object.entries(dict.statuts).map(([k, v]) => <option value={k}>{v.label}</option>)}
      </select>
    </label>
    <label class="filter-chip-label">
      <span>Thème</span>
      <select id="chart-filter-cat" class="filter-input">
        <option value="ALL">Tous les thèmes</option>
        {CATEGORIE_VALUES.map((cat) => <option value={cat}>{dict.categories[cat].label}</option>)}
      </select>
    </label>
    <div class="timeline-count-pill" id="chart-visible-count">—</div>
  </div>

  <div id="timeline-graph-panel">
    <div class="timeline-svg-scroll" id="timeline-svg-host"></div>
    <div class="timeline-hover-banner" id="timeline-hover-banner" aria-live="polite">
      Survolez ou touchez un repère (■ Condamnation définitive · ◆ Condamnation sous recours · ○ Relaxe ou classement · ◌ Procédure en cours).
    </div>
  </div>

  <div id="timeline-list-view" class="timeline-list" hidden></div>
</section>
